  "cards": [
    {
      "dot": "cyan",
      "title": "Same stack, two targets",
      "items": [
        "Terraform applies one resource graph to Floci or AWS",
        "AWS names include the account ID; Floci uses fixed names"
      ]
    },
    {
      "dot": "rose",
      "title": "Scoped permissions",
      "items": [
        "S3 writes only under processed/*; DynamoDB PutItem on one table",
        "The worker role has no s3:ListBucket, which the probe checks"
      ]
    },
    {
      "dot": "amber",
      "title": "Delivery",
      "items": [
        "At-least-once; no redrive policy or partial batch handling",
        "Same message ID overwrites the same S3 key and DynamoDB item"
      ]
    }
  ]
