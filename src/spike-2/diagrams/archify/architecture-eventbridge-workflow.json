      "dot": "cyan",
      "title": "Same stack, two targets",
      "items": [
        "Floci uses an IAM role for the EventBridge target",
        "AWS uses a Lambda resource policy for events.amazonaws.com"
      ]
    },
    {
      "dot": "amber",
      "title": "What the DLQ covers",
      "items": [
        "Only EventBridge target delivery failures",
        "A Step Functions or processor failure does not land there"
      ]
