  "cards": [
    {
      "dot": "rose",
      "title": "Public API, private images",
      "items": [
        "API and page are public; no user accounts, the job ID is a bearer reference",
        "Image objects stay private; access is by 15-minute upload and 5-minute download URLs"
      ]
    },
    {
      "dot": "cyan",
      "title": "Local Floci mode",
      "items": [
        "No CloudFront; serve.py serves the page on :8080 and proxies the API",
        "Default stub copies the input; apply-bedrock calls real Bedrock"
      ]
    },
    {
      "dot": "amber",
      "title": "Retries",
      "items": [
        "Partial-batch failures retry up to 3 receives, then the job is FAILED and the message moves to the DLQ"
      ]
    }
  ]
